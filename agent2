      "source": [
        "from langchain_openai import ChatOpenAI\n",
        "\n",
        "AGENT_LLM_CONFIG = {\n",
        "    \"disruption_monitoring\": {\n",
        "        \"api_key\": os.getenv(\"DISRUPTION_MONITORING_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"DISRUPTION_MONITORING_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"kg_query\": {\n",
        "        \"api_key\": os.getenv(\"KG_QUERY_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"KG_QUERY_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"product_search\": {\n",
        "        \"api_key\": os.getenv(\"PRODUCT_SEARCH_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"PRODUCT_SEARCH_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"visualizer\": {\n",
        "        \"api_key\": os.getenv(\"VISUALIZER_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"VISUALIZER_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"risk_manager\": {\n",
        "        \"api_key\": os.getenv(\"RISK_MANAGER_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"RISK_MANAGER_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"csco\": {\n",
        "        \"api_key\": os.getenv(\"CSCO_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"CSCO_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "    \"alternative_sourcing\": {\n",
        "        \"api_key\": os.getenv(\"ALTERNATIVE_SOURCING_OPENAI_API_KEY\"),\n",
        "        \"model\": os.getenv(\"ALTERNATIVE_SOURCING_MODEL\", \"gpt-4o\"),\n",
        "    },\n",
        "}\n",
        "\n",
        "def make_llm(agent_key: str, temperature: float = 0.1):\n",
        "    cfg = AGENT_LLM_CONFIG[agent_key]\n",
        "    if not cfg[\"api_key\"]:\n",
        "        raise ValueError(f\"{agent_key} API key is missing. Fill the matching key in .env.\")\n",
        "    return ChatOpenAI(model=cfg[\"model\"], api_key=cfg[\"api_key\"], temperature=temperature)\n"
