        "    regions={agent4_html_escape(', '.join(affected.get('regions', []) or []))};\n",
        "    materials={agent4_html_escape(', '.join(affected.get('materials', []) or []))};\n",
        "    chokepoints={agent4_html_escape(', '.join(affected.get('chokepoints', []) or []))}\n",
        "  </div>\n",
        "  <div style=\"margin-top:8px;\">\n",
        "    <input id=\"agent4Search\" placeholder=\"회사/공급업체/노드 검색\" style=\"padding:6px;width:260px;margin-top:4px;\" />\n",
        "    <button onclick=\"agent4SearchNode()\" style=\"padding:6px 10px;\">Search</button>\n",
        "    <span style=\"font-size:12px;color:#666;margin-left:8px;\">노드가 많을 때 특정 기업이나 공급업체 위치를 찾는 기능입니다.</span>\n",
        "  </div>\n",
        "  <div style=\"margin-top:8px;font-size:13px;\">\n",
        "    <strong>Legend:</strong>\n",
        "    Focal=dark blue, Tier1=blue, Tier2=green, Tier3=orange, Tier4=purple,\n",
        "    disrupted=red border, confirmed edge=solid, inferred/unknown=dashed.\n",
        "  </div>\n",
        "</section>\n",
        "\"\"\"\n",
        "    search_js = \"\"\"\n",
        "<script>\n",
        "function agent4SearchNode() {\n",
        "  var q = document.getElementById('agent4Search').value.toLowerCase();\n",
        "  if (!q || typeof nodes === 'undefined' || typeof network === 'undefined') return;\n",
        "  var matched = [];\n",
        "  nodes.forEach(function(n) {\n",
        "    if ((n.label || '').toLowerCase().indexOf(q) >= 0) matched.push(n.id);\n",
        "  });\n",
        "  if (matched.length > 0) {\n",
        "    network.selectNodes([matched[0]]);\n",
        "    network.focus(matched[0], {scale: 1.3, animation: true});\n",
        "  }\n",
        "}\n",
        "</script>\n",
        "\"\"\"\n",
        "    html_text = html_text.replace(\"<body>\", \"<body>\" + meta, 1).replace(\"</body>\", search_js + \"</body>\", 1)\n",
        "    output_path.write_text(html_text, encoding=\"utf-8\")\n",
        "    return {\"format\": \"html\", \"file_path\": str(output_path.resolve()), \"status\": \"success\"}\n",
        "\n",
        "def visualize_agent4_knowledge_graph(\n",
        "    kg_result: Dict[str, Any],\n",
        "    product_result: Optional[Dict[str, Any]] = None,\n",
        "    risk_result: Optional[Dict[str, Any]] = None,\n",
        "    output_html: str = \"agent4_supply_chain_network.html\",\n",
        ") -> Dict[str, Any]:\n",
        "    \"\"\"Build graph_spec, render interactive HTML, validate, and return the required Agent 4 JSON.\"\"\"\n",
        "    agent4_input = normalize_agent4_input(kg_result, product_result, risk_result)\n",
        "    graph_spec = build_agent4_graph_spec(agent4_input)\n",
        "    graph = build_network_graph(graph_spec)\n",
        "    validation = validate_graph(graph, agent4_input)\n",
        "\n",
        "    if graph.number_of_nodes() == 0:\n",
        "        render_result = {\"format\": \"html\", \"file_path\": None, \"status\": \"failed\"}\n",
        "        validation[\"warnings\"].append(\"No graph paths returned from Agent 2.\")\n",
