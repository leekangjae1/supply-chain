        "id": "f1e76dba"
      },
      "source": [
        "## BFS-Based Related Supply Chain Search\n",
        "\n",
        "논문 KG Query Agent의 핵심은 supplier chain을 Tier-4까지 추적하는 것입니다. 이 프로젝트에서는 관련성이 다음 방향으로 확장됩니다.\n",
        "\n",
        "- 직접 공급망: `Supplier -> Supplies -> Company/Supplier`\n",
        "- 생산 품목: `Supplier -> Produces -> Product`\n",
        "- 원재료 흐름: `Product/Material -> Requires_Material -> Material`, `Mined_From`, `Refined_From`\n",
        "- 물류 리스크: `Uses_Route`, `Shipped_From`, `Shipped_To`, `Passes_Through`\n",
        "- 지정학/에너지 리스크: `Exposed_To_Risk`, `Depends_On_Energy`\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "feeac464",
      "metadata": {
        "id": "feeac464"
      },
      "outputs": [],
      "source": [
        "SKIP_RISK_CATEGORIES = {\"\", \"unknown\", \"none\", \"not_applicable\", \"not applicable\", \"no_risk\"}\n",
        "SKIP_EVENT_TYPES = {\"\", \"none\", \"unknown\", \"not_applicable\", \"not applicable\"}\n",
        "SAFE_MAX_DEPTH = 4\n",
        "\n",
        "\n",
        "def is_actionable_disruption(row: Dict[str, Any]) -> bool:\n",
        "    \"\"\"Skip rows that Agent 1 did not classify as meaningful supply-chain disruptions.\"\"\"\n",
        "    disruption_flag = row.get(\"is_disruption\", row.get(\"is_supply_chain_disruption\", False))\n",
        "    if not bool(disruption_flag):\n",
        "        return False\n",
        "\n",
        "    risk_category = (\n",
        "        row.get(\"risk_category\")\n",
        "        or row.get(\"disruption_type\")\n",
        "        or row.get(\"disruption_category\")\n",
        "        or row.get(\"event_type\")\n",
        "        or row.get(\"event\")\n",
        "        or \"\"\n",
        "    )\n",
        "    event_type = row.get(\"event_type\") or row.get(\"event\") or row.get(\"disruption_event\") or \"\"\n",
        "    risk_category = str(risk_category).strip().lower()\n",
        "    event_type = str(event_type).strip().lower()\n",
        "\n",
        "    if risk_category in SKIP_RISK_CATEGORIES and event_type in SKIP_EVENT_TYPES:\n",
        "        return False\n",
        "    return True\n",
        "\n",
        "def disruption_entities(disruption: Dict[str, Any]) -> List[str]:\n",
        "    involved = disruption.get(\"involved\", {})\n",
        "    values = []\n",
        "    for key in [\"countries\", \"regions\", \"companies\", \"industries\", \"risks\"]:\n",
        "        values.extend(involved.get(key, []) or [])\n",
        "    values.extend([\n",
        "        disruption.get(\"event_type\"),\n",
        "        disruption.get(\"type\"),\n",
        "        disruption.get(\"summary\"),\n",
        "    ])\n",
        "    values.extend(disruption.get(\"kg_questions\", []) or [])\n",
        "    return sorted({str(v).strip() for v in values if v and str(v).strip()})\n",
        "\n",
        "def node_to_dict(node) -> Dict[str, Any]:\n",
        "    data = dict(node)\n",
        "    data[\"labels\"] = list(node.labels)\n",
        "    data[\"element_id\"] = node.element_id\n",
        "    return data\n",
        "\n",
        "def rel_to_dict(rel) -> Dict[str, Any]:\n",
        "    data = dict(rel)\n",
        "    data[\"neo4j_type\"] = rel.type\n",
        "    data[\"element_id\"] = rel.element_id\n",
        "    data[\"start_element_id\"] = rel.start_node.element_id\n",
        "    data[\"end_element_id\"] = rel.end_node.element_id\n",
        "    data[\"relation\"] = data.get(\"type\") or data.get(\"relation\") or rel.type\n",
        "    data[\"semantic_relation\"] = data[\"relation\"]\n",
        "    return data\n",
        "\n",
        "def path_to_result(path) -> Dict[str, Any]:\n",
        "    nodes = [node_to_dict(node) for node in path.nodes]\n",
        "    rels = [rel_to_dict(rel) for rel in path.relationships]\n",
        "    node_names = [\n",
        "        n.get(\"name\") or n.get(\"entity_id\") or n.get(\"element_id\")\n",
        "        for n in nodes\n",
        "    ]\n",
        "    relations = []\n",
        "    for idx, rel in enumerate(rels):\n",
        "        relations.append({\n",
        "            \"from\": node_names[idx],\n",
        "            \"to\": node_names[idx + 1],\n",
        "            \"relation\": rel.get(\"relation\"),\n",
        "            \"properties\": rel,\n",
        "        })\n",
        "    return {\n",
        "        \"matched_node\": node_names[-1],\n",
        "        \"matched_node_data\": nodes[-1],\n",
        "        \"path\": node_names,\n",
        "        \"path_nodes\": nodes,\n",
        "        \"relations\": relations,\n",
        "        \"depth\": len(rels),\n",
        "    }\n",
        "\n",
        "def extract_json_object(text: str) -> Dict[str, Any]:\n",
        "    \"\"\"Parse a JSON object even if the LLM wraps it in markdown fences.\"\"\"\n",
        "    cleaned = text.strip()\n",
        "    if cleaned.startswith(\"```\"):\n",
        "        cleaned = cleaned.strip(\"`\")\n",
        "        if cleaned.lower().startswith(\"json\"):\n",
        "            cleaned = cleaned[4:].strip()\n",
        "    start = cleaned.find(\"{\")\n",
        "    end = cleaned.rfind(\"}\")\n",
        "    if start == -1 or end == -1:\n",
        "        raise ValueError(f\"No JSON object found in LLM output: {text[:500]}\")\n",
        "    return json.loads(cleaned[start:end + 1])\n",
        "\n",
        "def fallback_query_plan(disruption: Dict[str, Any], focal_company: str) -> Dict[str, Any]:\n",
        "    entities = disruption_entities(disruption)\n",
        "    return {\n",
        "        \"focal_company_aliases\": [focal_company],\n",
        "        \"expanded_entities\": entities,\n",
        "        \"entity_types\": ENTITY_TYPES,\n",
        "        \"relations\": RELATION_TYPES,\n",
        "        \"max_depth\": SAFE_MAX_DEPTH,\n",
        "        \"rationale\": \"Fallback plan built from structured Agent 1 fields because LLM query planning was unavailable.\",\n",
        "    }\n",
        "\n",
        "def generate_kg_query_plan_with_llm(disruption: Dict[str, Any], focal_company: str = \"Hyundai\") -> Dict[str, Any]:\n",
        "    \"\"\"Agent 2 LLM step: understand context, synonyms, entity types, and relation candidates.\"\"\"\n",
        "    llm = make_llm(\"kg_query\", temperature=0.0)\n",
        "    prompt = f\"\"\"\n",
        "You are Agent 2: Knowledge Graph Query Agent for supply-chain disruption monitoring.\n",
        "\n",
        "Your job is NOT to execute Neo4j. Your job is to convert Agent 1 output into a safe structured query plan.\n",
        "The Python tool will validate this plan and build the Cypher query.\n",
        "\n",
        "Neo4j schema:\n",
        "- All nodes have label :Entity.\n",
        "- Node properties include: entity_id, name, Type, description, source.\n",
        "- Entity types available in the KG:\n",
        "{json.dumps(ENTITY_TYPES, ensure_ascii=False)}\n",
        "- All relationships have type :KG_RELATION.\n",
        "- The original semantic relation is stored in relationship property r.type.\n",
        "- Relation types available in the KG:\n",
        "{json.dumps(RELATION_TYPES, ensure_ascii=False)}\n",
        "\n",
        "Agent 1 disruption JSON:\n",
        "{json.dumps(disruption, ensure_ascii=False, indent=2)}\n",
        "\n",
        "Focal company:\n",
        "{focal_company}\n",
        "\n",
        "The paper's Agent 2 prompt pattern is: receive disruption information and risk exposure\n",
        "questions from Agent 1, resolve free-text entities into KG identifiers, generate tier-specific\n",
        "company lists, and run breadth-first supply-chain traversal up to Tier-4. Follow that pattern.\n",
        "\n",
        "Build a query plan that expands synonyms, Korean/English variants, company aliases, region/country variants,\n",
        "risk/event synonyms, route/chokepoint/material aliases, relevant entity types, and relevant relation types.\n",
        "Do not invent supplier relationships, products, or paths. Only propose search terms and allowed KG schema filters.\n",
        "Use only the entity types and relation types listed above.\n",
        "If the article is not a meaningful supply-chain disruption, set should_query=false.\n",
        "\n",
        "Return ONLY strict JSON:\n",
        "{{\n",
        "  \"should_query\": true,\n",
        "  \"focal_company_aliases\": [\"the focal company name and its aliases\"],\n",
        "  \"expanded_entities\": [\"canonical terms, synonyms, English/Korean variants, route/material/chokepoint aliases\"],\n",
        "  \"entity_types\": [\"Company\", \"Supplier\", \"Country\"],\n",
        "  \"relations\": [\"Supplies\", \"Located_In\"],\n",
        "  \"max_depth\": 4,\n",
        "  \"rationale\": \"short reason\"\n",
        "}}\n",
        "\"\"\"\n",
        "    response = llm.invoke(prompt)\n",
        "    content = getattr(response, \"content\", str(response))\n",
        "    plan = extract_json_object(content)\n",
        "    return validate_query_plan(plan, disruption, focal_company)\n",
        "\n",
        "\n",
        "DOMAIN_SYNONYMS = {\n",
        "    \"red sea\": [\"Red Sea\", \"홍해\"],\n",
        "    \"홍해\": [\"Red Sea\", \"홍해\"],\n",
        "    \"bab el-mandeb\": [\"Bab el-Mandeb\", \"Bab al-Mandab\", \"바브엘만데브\", \"만데브 해협\"],\n",
        "    \"taiwan strait\": [\"Taiwan Strait\", \"대만 해협\"],\n",
        "    \"taiwan\": [\"Taiwan\", \"대만\", \"Chinese Taipei\"],\n",
        "    \"japan\": [\"Japan\", \"일본\"],\n",
        "    \"iran\": [\"Iran\", \"이란\"],\n",
        "    \"oil\": [\"oil\", \"crude oil\", \"petroleum\", \"원유\", \"석유\"],\n",
        "    \"semiconductor\": [\"semiconductor\", \"chip\", \"반도체\"],\n",
        "    \"logistics\": [\"logistics\", \"shipping\", \"transportation\", \"물류\", \"해상 운송\"],\n",
        "    \"geopolitical\": [\"geopolitical\", \"political risk\", \"지정학\", \"지정학 리스크\"],\n",
        "}\n",
        "\n",
        "def expand_terms_deterministic(terms: List[str]) -> List[str]:\n",
        "    \"\"\"Add conservative bilingual/domain synonyms without inventing KG facts.\"\"\"\n",
        "    expanded = []\n",
        "    for term in terms:\n",
        "        text = str(term).strip()\n",
        "        if not text:\n",
        "            continue\n",
        "        expanded.append(text)\n",
        "        lower = text.lower()\n",
        "        for key, values in DOMAIN_SYNONYMS.items():\n",
        "            if key in lower or lower in key:\n",
        "                expanded.extend(values)\n",
        "    return unique_clean(expanded) if \"unique_clean\" in globals() else sorted({x for x in expanded if x})\n",
        "\n",
        "def get_kg_term_candidates(terms: List[str], limit: int = 50) -> List[str]:\n",
        "    \"\"\"Find existing KG node names/descriptions that match expanded terms, grounding Agent 2 terms in Neo4j.\"\"\"\n",
        "    if \"driver\" not in globals() or driver is None:\n",
        "        return []\n",
        "    if not terms:\n",
        "        return []\n",
        "    query = \"\"\"\n",
        "    MATCH (e:Entity)\n",
        "    WHERE any(term IN $terms WHERE size(term) >= 2 AND (\n",
        "        toLower(coalesce(e.name, '')) CONTAINS toLower(term)\n",
        "        OR toLower(coalesce(e.entity_id, '')) CONTAINS toLower(term)\n",
        "        OR toLower(coalesce(e.description, '')) CONTAINS toLower(term)\n",
        "        OR toLower(coalesce(e.Type, e.type, '')) CONTAINS toLower(term)\n",
        "    ))\n",
        "    RETURN e.name AS name, e.entity_id AS entity_id, e.Type AS type\n",
        "    LIMIT $limit\n",
        "    \"\"\"\n",
        "    try:\n",
        "        with driver.session() as session:\n",
        "            rows = list(session.run(query, terms=terms, limit=limit))\n",
        "        candidates = []\n",
        "        for row in rows:\n",
        "            if row.get(\"name\"):\n",
        "                candidates.append(row[\"name\"])\n",
        "            if row.get(\"entity_id\"):\n",
        "                candidates.append(row[\"entity_id\"])\n",
        "        return expand_terms_deterministic(candidates)\n",
        "    except Exception as exc:\n",
        "        print(f\"KG candidate lookup failed; continuing with LLM/fallback terms only: {exc}\")\n",
        "        return []\n",
        "\n",
        "\n",
        "def validate_query_plan(plan: Dict[str, Any], disruption: Dict[str, Any], focal_company: str) -> Dict[str, Any]:\n",
        "    allowed_entity_types = set(ENTITY_TYPES)\n",
        "    allowed_relations = set(RELATION_TYPES)\n",
        "\n",
        "    if not isinstance(plan, dict):\n",
        "        plan = {}\n",
        "\n",
        "    should_query = bool(plan.get(\"should_query\", True))\n",
        "    focal_aliases = plan.get(\"focal_company_aliases\") or [focal_company]\n",
        "    expanded_entities = plan.get(\"expanded_entities\") or disruption_entities(disruption)\n",
        "    entity_types = plan.get(\"entity_types\") or ENTITY_TYPES\n",
        "    relations = plan.get(\"relations\") or RELATION_TYPES\n",
        "\n",
        "    focal_aliases = sorted({str(x).strip() for x in expand_terms_deterministic(focal_aliases + [focal_company]) if x and str(x).strip()})\n",
        "    seed_entities = expand_terms_deterministic(expanded_entities + disruption_entities(disruption))\n",
        "    kg_candidates = get_kg_term_candidates(seed_entities)\n",
        "    expanded_entities = sorted({str(x).strip() for x in seed_entities + kg_candidates if x and str(x).strip()})\n",
        "    entity_types = [x for x in entity_types if x in allowed_entity_types]\n",
        "    relations = [x for x in relations if x in allowed_relations]\n",
        "\n",
        "    try:\n",
        "        max_depth = int(plan.get(\"max_depth\", SAFE_MAX_DEPTH))\n",
        "    except Exception:\n",
        "        max_depth = SAFE_MAX_DEPTH\n",
        "    max_depth = max(1, min(max_depth, SAFE_MAX_DEPTH))\n",
        "\n",
        "    return {\n",
        "        \"should_query\": should_query,\n",
        "        \"focal_company_aliases\": focal_aliases,\n",
        "        \"expanded_entities\": expanded_entities,\n",
        "        \"entity_types\": entity_types or ENTITY_TYPES,\n",
        "        \"relations\": relations or RELATION_TYPES,\n",
        "        \"max_depth\": max_depth,\n",
        "        \"rationale\": str(plan.get(\"rationale\", \"\"))[:1000],\n",
        "    }\n",
        "\n",
        "def build_safe_cypher_from_plan(plan: Dict[str, Any]) -> Tuple[str, Dict[str, Any]]:\n",
        "    max_depth = int(plan.get(\"max_depth\", SAFE_MAX_DEPTH))\n",
        "    query = f\"\"\"\n",
        "    MATCH p = (focal:Entity)-[*1..{max_depth}]-(n:Entity)\n",
        "    WHERE (\n",
        "        focal.name IN $focal_company_aliases\n",
        "        OR focal.entity_id IN $focal_company_aliases\n",
        "        OR any(alias IN $focal_company_aliases WHERE toLower(coalesce(focal.name, '')) CONTAINS toLower(alias))\n",
        "    )\n",
        "      AND all(rel IN relationships(p) WHERE coalesce(rel.type, type(rel)) IN $relations)\n",
        "      AND (\n",
        "        n.name IN $expanded_entities\n",
        "        OR n.entity_id IN $expanded_entities\n",
        "        OR any(term IN $expanded_entities WHERE size(term) >= 2 AND toLower(coalesce(n.name, '')) CONTAINS toLower(term))\n",
        "        OR any(term IN $expanded_entities WHERE size(term) >= 2 AND toLower(coalesce(n.description, '')) CONTAINS toLower(term))\n",
        "      )\n",
        "      AND (\n",
        "        size($entity_types) = 0\n",
        "        OR n.Type IN $entity_types\n",
        "        OR n.type IN $entity_types\n",
        "        OR n.Type IS NULL\n",
        "      )\n",
        "    RETURN p\n",
        "    LIMIT $limit\n",
        "    \"\"\"\n",
        "    params = {\n",
        "        \"focal_company_aliases\": plan[\"focal_company_aliases\"],\n",
        "        \"expanded_entities\": plan[\"expanded_entities\"],\n",
        "        \"entity_types\": plan[\"entity_types\"],\n",
        "        \"relations\": plan[\"relations\"],\n",
        "        \"limit\": 200,\n",
        "    }\n",
        "    return query, params\n",
        "\n",
        "def run_neo4j_path_query(query: str, params: Dict[str, Any]) -> List[Dict[str, Any]]:\n",
        "    with driver.session() as session:\n",
        "        records = session.run(query, **params)\n",
        "        return [path_to_result(record[\"p\"]) for record in records]\n",
        "\n",
        "\n",
        "def debug_neo4j_agent2_search(focal_company: str, plan: Dict[str, Any], limit: int = 25) -> Dict[str, Any]:\n",
        "    \"\"\"Explain why Agent 2 returned no paths by checking focal and disruption term matches separately.\"\"\"\n",
        "    diagnostics = {\n",
        "        \"focal_company\": focal_company,\n",
        "        \"focal_aliases\": plan.get(\"focal_company_aliases\", []),\n",
        "        \"expanded_entities\": plan.get(\"expanded_entities\", []),\n",
        "        \"relations\": plan.get(\"relations\", []),\n",
        "        \"entity_types\": plan.get(\"entity_types\", []),\n",
        "        \"focal_matches\": [],\n",
        "        \"entity_matches\": [],\n",
        "        \"relation_counts\": [],\n",
        "        \"likely_reason\": \"\",\n",
        "    }\n",
        "    with driver.session() as session:\n",
        "        focal_query = \"\"\"\n",
        "        MATCH (e:Entity)\n",
        "        WHERE e.name IN $aliases\n",
        "           OR e.entity_id IN $aliases\n",
        "           OR any(alias IN $aliases WHERE size(alias) >= 2 AND toLower(coalesce(e.name, '')) CONTAINS toLower(alias))\n",
        "        RETURN e.entity_id AS entity_id, e.name AS name, e.Type AS type\n",
        "        LIMIT $limit\n",
        "        \"\"\"\n",
        "        diagnostics[\"focal_matches\"] = [dict(r) for r in session.run(\n",
        "            focal_query,\n",
        "            aliases=plan.get(\"focal_company_aliases\", [focal_company]),\n",
        "            limit=limit,\n",
        "        )]\n",
        "\n",
        "        entity_query = \"\"\"\n",
        "        MATCH (e:Entity)\n",
        "        WHERE e.name IN $terms\n",
        "           OR e.entity_id IN $terms\n",
        "           OR e.Type IN $terms\n",
        "           OR any(term IN $terms WHERE size(term) >= 2 AND toLower(coalesce(e.name, '')) CONTAINS toLower(term))\n",
        "           OR any(term IN $terms WHERE size(term) >= 2 AND toLower(coalesce(e.description, '')) CONTAINS toLower(term))\n",
        "        RETURN e.entity_id AS entity_id, e.name AS name, e.Type AS type\n",
        "        LIMIT $limit\n",
        "        \"\"\"\n",
        "        diagnostics[\"entity_matches\"] = [dict(r) for r in session.run(\n",
        "            entity_query,\n",
        "            terms=plan.get(\"expanded_entities\", []),\n",
        "            limit=limit,\n",
        "        )]\n",
        "\n",
        "        relation_query = \"\"\"\n",
        "        MATCH (:Entity)-[r]->(:Entity)\n",
        "        RETURN coalesce(r.type, type(r)) AS relation, count(*) AS count\n",
        "        ORDER BY count DESC\n",
        "        LIMIT $limit\n",
        "        \"\"\"\n",
        "        diagnostics[\"relation_counts\"] = [dict(r) for r in session.run(relation_query, limit=limit)]\n",
        "\n",
        "    if not diagnostics[\"focal_matches\"]:\n",
        "        diagnostics[\"likely_reason\"] = \"No focal company node matched. Check focal_company spelling and KG company names.\"\n",
        "    elif not diagnostics[\"entity_matches\"]:\n",
        "        diagnostics[\"likely_reason\"] = \"No disruption entity matched KG nodes. The Agent 1 event terms may not exist in the KG.\"\n",
        "    else:\n",
        "        diagnostics[\"likely_reason\"] = \"Focal and disruption entities both exist, but no path connects them within max_depth and selected relations.\"\n",
        "    return diagnostics\n",
        "\n",
        "\n",
        "def _node_name(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"name\") or node.get(\"entity_id\") or node.get(\"element_id\"))\n",
        "\n",
        "def _node_id(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"entity_id\") or node.get(\"element_id\") or node.get(\"name\"))\n",
        "\n",
        "def _node_type(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"Type\") or node.get(\"type\") or \"\")\n",
        "\n",
        "def _first_tier1_supplier_from_path(path_nodes: List[Dict[str, Any]], focal_company: str) -> Optional[Dict[str, Any]]:\n",
        "    \"\"\"Find the supplier nearest to the focal company; this is the Tier-1 supplier for Agent 5.\"\"\"\n",
        "    focal_index = None\n",
        "    focal_lower = str(focal_company).lower()\n",
        "    for idx, node in enumerate(path_nodes):\n",
        "        node_name = _node_name(node).lower()\n",
        "        node_id = _node_id(node).lower()\n",
        "        if focal_lower in {node_name, node_id} or focal_lower in node_name:\n",
        "            focal_index = idx\n",
        "            break\n",
        "    candidates = [\n",
        "        (abs(idx - focal_index), idx, node) if focal_index is not None else (idx, idx, node)\n",
        "        for idx, node in enumerate(path_nodes)\n",
        "        if _node_type(node) == \"Supplier\"\n",
        "    ]\n",
        "    if not candidates:\n",
        "        return None\n",
        "    return sorted(candidates, key=lambda item: item[0])[0][2]\n",
        "\n",
        "def convert_agent2_paths_for_agent5(kg_result: Dict[str, Any]) -> List[Dict[str, Any]]:\n",
        "    \"\"\"Convert Agent 2 matched_paths into Agent 5 affected_paths input.\"\"\"\n",
        "    focal_name = kg_result.get(\"focal_company\") or globals().get(\"focal_company\", \"\")\n",
        "    affected_paths = []\n",
        "    for item in kg_result.get(\"matched_paths\", []):\n",
        "        path_nodes = item.get(\"path_nodes\", [])\n",
        "        tier1 = _first_tier1_supplier_from_path(path_nodes, focal_name)\n",
        "        if not tier1:\n",
        "            continue\n",
        "\n",
        "        components = unique_clean([\n",
        "            _node_name(node) for node in path_nodes\n",
        "            if _node_type(node) == \"Product\"\n",
        "        ])\n",
        "        materials = unique_clean([\n",
        "            _node_name(node) for node in path_nodes\n",
        "            if _node_type(node) in {\"Material\", \"EnergySource\"}\n",
        "        ])\n",
        "        chokepoints = unique_clean([\n",
        "            _node_name(node) for node in path_nodes\n",
        "            if _node_type(node) in {\"ChokePoint\", \"SeaRegion\", \"Port\", \"Route\", \"GeopoliticalRisk\"}\n",
        "        ])\n",
        "\n",
        "        affected_paths.append({\n",
        "            \"tier1_supplier\": _node_name(tier1),\n",
        "            \"tier1_supplier_id\": _node_id(tier1),\n",
        "            \"matched_node\": item.get(\"matched_node\"),\n",
        "            \"path\": item.get(\"path\", []),\n",
        "            \"relations\": item.get(\"relations\", []),\n",
        "            \"affected_components\": components,\n",
        "            \"affected_materials\": materials,\n",
        "            \"affected_chokepoints\": chokepoints,\n",
        "            \"max_tier_depth\": min(int(item.get(\"depth\", 1) or 1), SAFE_MAX_DEPTH),\n",
        "            \"path_nodes\": path_nodes,\n",
        "        })\n",
        "    return affected_paths\n",
        "\n",
        "def build_agent5_input_from_agent2(\n",
        "    kg_result: Dict[str, Any],\n",
        "    product_result: Optional[Dict[str, Any]] = None,\n",
        ") -> Dict[str, Any]:\n",
        "    \"\"\"Build the JSON shape expected by Agent 5 Risk Manager.\"\"\"\n",
        "    disruption = kg_result.get(\"disruption\", {})\n",
        "    involved = disruption.get(\"involved\", {})\n",
        "    affected_paths = convert_agent2_paths_for_agent5(kg_result)\n",
        "\n",
        "    # Add Agent 3 product/material mapping when it found extra annotations.\n",
        "    if product_result:\n",
        "        mappings = product_result.get(\"mappings\", [])\n",
        "        for idx, mapping in enumerate(mappings):\n",
        "            if idx >= len(affected_paths):\n",
        "                break\n",
        "            affected_paths[idx][\"affected_components\"] = unique_clean(\n",
        "                affected_paths[idx].get(\"affected_components\", []) + mapping.get(\"products\", [])\n",
        "            )\n",
        "            affected_paths[idx][\"affected_materials\"] = unique_clean(\n",
        "                affected_paths[idx].get(\"affected_materials\", []) + mapping.get(\"materials\", [])\n",
        "            )\n",
        "            affected_paths[idx][\"affected_chokepoints\"] = unique_clean(\n",
        "                affected_paths[idx].get(\"affected_chokepoints\", []) + mapping.get(\"routes\", []) + mapping.get(\"risk_nodes\", [])\n",
        "            )\n",
        "\n",
        "    return {\n",
        "        \"disruption_info\": {\n",
        "            \"disruption_type\": disruption.get(\"type\"),\n",
        "            \"event_type\": disruption.get(\"event_type\"),\n",
        "            \"affected_countries\": involved.get(\"countries\", []),\n",
        "            \"affected_regions\": involved.get(\"regions\", []),\n",
        "            \"affected_industries\": involved.get(\"industries\", []),\n",
        "            \"affected_companies\": involved.get(\"companies\", []),\n",
        "            \"affected_risks\": involved.get(\"risks\", []),\n",
        "            \"kg_questions\": disruption.get(\"kg_questions\", []),\n",
        "            \"source\": disruption.get(\"source\", {}),\n",
        "        },\n",
        "        \"affected_paths\": affected_paths,\n",
        "        \"product_mapping\": product_result or {},\n",
        "    }\n",
        "\n",
        "def neo4j_related_supply_chain(\n",
        "    focal_company: str,\n",
        "    disruption: Dict[str, Any],\n",
        "    max_depth: int = SAFE_MAX_DEPTH,\n",
        "    limit: int = 200,\n",
        "    use_llm_plan: bool = True,\n",
        ") -> Dict[str, Any]:\n",
        "    if use_llm_plan:\n",
        "        try:\n",
        "            plan = generate_kg_query_plan_with_llm(disruption, focal_company)\n",
        "        except Exception as exc:\n",
        "            print(f\"LLM query planning failed, using fallback plan: {exc}\")\n",
        "            plan = fallback_query_plan(disruption, focal_company)\n",
        "    else:\n",
        "        plan = fallback_query_plan(disruption, focal_company)\n",
        "\n",
        "    plan[\"max_depth\"] = min(int(plan.get(\"max_depth\", max_depth)), int(max_depth), SAFE_MAX_DEPTH)\n",
        "\n",
        "    if not plan.get(\"should_query\", True):\n",
        "        return {\n",
        "            \"focal_company\": focal_company,\n",
        "            \"disruption\": disruption,\n",
        "            \"query_plan\": plan,\n",
        "            \"cypher\": None,\n",
        "            \"cypher_params\": None,\n",
        "            \"matched_paths\": [],\n",
        "            \"visited_nodes\": 0,\n",
        "            \"skipped\": True,\n",
        "        }\n",
        "\n",
        "    query, params = build_safe_cypher_from_plan(plan)\n",
        "    params[\"limit\"] = limit\n",
        "    matched_paths = run_neo4j_path_query(query, params)\n",
        "    diagnostics = None\n",
        "    if not matched_paths:\n",
        "        diagnostics = debug_neo4j_agent2_search(focal_company, plan)\n",
        "        print(\"Agent 2 returned 0 matched paths.\")\n",
        "        print(\"Likely reason:\", diagnostics.get(\"likely_reason\"))\n",
        "        print(\"Focal matches:\", len(diagnostics.get(\"focal_matches\", [])))\n",
        "        print(\"Disruption entity matches:\", len(diagnostics.get(\"entity_matches\", [])))\n",
        "\n",
        "    visited_nodes = len({\n",
        "        node.get(\"element_id\")\n",
        "        for item in matched_paths\n",
        "        for node in item.get(\"path_nodes\", [])\n",
        "    })\n",
        "\n",
        "    return {\n",
        "        \"focal_company\": focal_company,\n",
        "        \"disruption\": disruption,\n",
        "        \"query_plan\": plan,\n",
        "        \"cypher\": query,\n",
        "        \"cypher_params\": params,\n",
        "        \"matched_paths\": matched_paths,\n",
        "        \"affected_paths\": convert_agent2_paths_for_agent5({\n",
        "            \"focal_company\": focal_company,\n",
        "            \"disruption\": disruption,\n",
        "            \"matched_paths\": matched_paths,\n",
        "        }),\n",
        "        \"visited_nodes\": visited_nodes,\n",
        "        \"diagnostics\": diagnostics,\n",
        "        \"skipped\": False,\n",
        "    }\n",
        "\n",
        "# Keep the public function name used by the CrewAI tool.\n",
        "def bfs_related_supply_chain(\n",
        "    graph,\n",
        "    focal_company: str,\n",
        "    disruption: Dict[str, Any],\n",
        "    max_depth: int = SAFE_MAX_DEPTH,\n",
        "    allowed_relations: Optional[set] = None,\n",
        ") -> Dict[str, Any]:\n",
        "    return neo4j_related_supply_chain(focal_company, disruption, max_depth=max_depth, use_llm_plan=True)\n"
      ]
    },
