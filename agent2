      "source": [
        "def inspect_agent2_subgraph(kg_result: Dict[str, Any], max_rows: int = 50) -> Dict[str, Any]:\n",
        "    \"\"\"Summarize the Neo4j subgraph returned by Agent 2.\"\"\"\n",
        "    matched_paths = kg_result.get(\"matched_paths\", [])\n",
        "\n",
        "    path_rows = []\n",
        "    relation_rows = []\n",
        "    node_by_id = {}\n",
        "\n",
        "    for path_idx, item in enumerate(matched_paths):\n",
        "        path_rows.append({\n",
        "            \"path_index\": path_idx,\n",
        "            \"depth\": item.get(\"depth\"),\n",
        "            \"matched_node\": item.get(\"matched_node\"),\n",
        "            \"path\": \" -> \".join(item.get(\"path\", [])),\n",
        "        })\n",
        "\n",
        "        for node in item.get(\"path_nodes\", []):\n",
        "            node_id = node.get(\"entity_id\") or node.get(\"element_id\")\n",
        "            node_by_id[node_id] = {\n",
        "                \"entity_id\": node.get(\"entity_id\"),\n",
        "                \"name\": node.get(\"name\"),\n",
        "                \"Type\": node.get(\"Type\") or node.get(\"type\"),\n",
        "                \"description\": node.get(\"description\"),\n",
        "                \"source\": node.get(\"source\"),\n",
        "                \"labels\": node.get(\"labels\"),\n",
        "                \"element_id\": node.get(\"element_id\"),\n",
        "            }\n",
        "\n",
        "        for rel_idx, rel in enumerate(item.get(\"relations\", [])):\n",
        "            props = rel.get(\"properties\", {})\n",
        "            relation_rows.append({\n",
        "                \"path_index\": path_idx,\n",
        "                \"rel_index\": rel_idx,\n",
        "                \"from\": rel.get(\"from\"),\n",
        "                \"relation\": rel.get(\"relation\"),\n",
        "                \"to\": rel.get(\"to\"),\n",
        "                \"relation_id\": props.get(\"relation_id\"),\n",
        "                \"evidence\": props.get(\"evidence\"),\n",
        "                \"confidence\": props.get(\"confidence\"),\n",
        "                \"tier\": props.get(\"tier\"),\n",
        "                \"notes\": props.get(\"notes\"),\n",
        "            })\n",
        "\n",
        "    paths_df = pd.DataFrame(path_rows)\n",
        "    relations_df = pd.DataFrame(relation_rows)\n",
        "    nodes_df = pd.DataFrame(list(node_by_id.values()))\n",
        "\n",
        "    node_ids = [\n",
        "        node_id for node_id in node_by_id.keys()\n",
        "        if node_id and not str(node_id).startswith(\"4:\")\n",
        "    ]\n",
        "    browser_cypher = \"\"\"\n",
        "MATCH p = (a:Entity)-[r:KG_RELATION]-(b:Entity)\n",
        "WHERE a.entity_id IN $node_ids AND b.entity_id IN $node_ids\n",
        "RETURN p\n",
        "LIMIT 200;\n",
        "\"\"\".strip()\n",
        "\n",
        "    print(\"What each output means:\")\n",
        "    print(\"- query_plan: LLM output. It contains focal aliases, synonym-expanded entities, allowed entity types, relation types, depth, and rationale.\")\n",
        "    print(\"- cypher: The validated safe Cypher generated from query_plan. This is what Agent 2 sends to Neo4j.\")\n",
        "    print(\"- cypher_params: Runtime parameters inserted into the Cypher query.\")\n",
        "    print(\"- paths_df: One row per returned supply-chain/risk path.\")\n",
        "    print(\"- relations_df: One row per relationship inside the returned paths.\")\n",
        "    print(\"- nodes_df: Unique nodes included in the returned subgraph.\")\n",
        "    print(\"- browser_cypher/browser_params: Query you can paste into Neo4j Browser to visually inspect the same returned subgraph.\")\n",
        "\n",
        "    print(\"\\nAgent 2 query plan:\")\n",
        "    print(json.dumps(kg_result.get(\"query_plan\", {}), ensure_ascii=False, indent=2))\n",
        "    print(\"\\nGenerated Cypher used by Agent 2:\")\n",
        "    print(kg_result.get(\"cypher\"))\n",
        "    print(\"\\nCypher params:\")\n",
        "    print(json.dumps(kg_result.get(\"cypher_params\", {}), ensure_ascii=False, indent=2, default=str))\n",
        "    print(f\"\\nMatched paths: {len(matched_paths)}\")\n",
        "    print(f\"Unique nodes in returned subgraph: {len(nodes_df)}\")\n",
        "    print(f\"Relations in returned paths: {len(relations_df)}\")\n",
        "    print(\"\\nNeo4j Browser check Cypher:\")\n",
        "    print(browser_cypher)\n",
        "    print(\"\\nNeo4j Browser params:\")\n",
        "    print(json.dumps({\"node_ids\": node_ids}, ensure_ascii=False, indent=2))\n",
        "\n",
        "    return {\n",
        "        \"paths_df\": paths_df.head(max_rows),\n",
        "        \"relations_df\": relations_df.head(max_rows),\n",
        "        \"nodes_df\": nodes_df.head(max_rows),\n",
        "        \"browser_cypher\": browser_cypher,\n",
        "        \"browser_params\": {\"node_ids\": node_ids},\n",
        "    }\n",
        "\n",
        "subgraph_check = inspect_agent2_subgraph(pipeline_result[\"kg_result\"])\n",
        "\n",
        "display(subgraph_check[\"paths_df\"])\n",
        "display(subgraph_check[\"relations_df\"])\n",
        "display(subgraph_check[\"nodes_df\"])\n"
      ]
    },
