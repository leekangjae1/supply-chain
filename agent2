        "    Agent = Task = Crew = Process = None\n",
        "    CREWAI_AVAILABLE = False\n",
        "\n",
        "    class LocalTool:\n",
        "        def __init__(self, name, func):\n",
        "            self.name = name\n",
        "            self.func = func\n",
        "            self.__name__ = getattr(func, \"__name__\", name)\n",
        "            self.__doc__ = getattr(func, \"__doc__\", None)\n",
        "\n",
        "        def __call__(self, *args, **kwargs):\n",
        "            return self.func(*args, **kwargs)\n",
        "\n",
        "        def run(self, *args, **kwargs):\n",
        "            return self.func(*args, **kwargs)\n",
        "\n",
        "    def tool(name):\n",
        "        def decorator(func):\n",
        "            return LocalTool(name, func)\n",
        "        return decorator\n",
        "\n",
        "    print(\"CrewAI is not installed. Deterministic local tools are available; run `!pip install crewai crewai-tools` before using build_agents().\")\n",
        "\n",
        "\n",
        "@tool(\"kg_bfs_related_supply_chain\")\n",
        "def kg_bfs_related_supply_chain(disruption_json: str, focal_company: str = \"Hyundai\", max_depth: int = 4) -> str:\n",
        "    \"\"\"Find related supply-chain nodes using Neo4j variable-length path traversal.\"\"\"\n",
        "    disruption = json.loads(disruption_json) if isinstance(disruption_json, str) else disruption_json\n",
        "    result = neo4j_related_supply_chain(focal_company=focal_company, disruption=disruption, max_depth=max_depth)\n",
        "    return json.dumps(result, ensure_ascii=False, indent=2)\n",
        "\n",
        "@tool(\"product_mapping_from_paths\")\n",
        "def product_mapping_from_paths(paths_json: str) -> str:\n",
        "    \"\"\"Annotate Neo4j paths with products/materials/routes/risk nodes found on each path.\"\"\"\n",
        "    data = json.loads(paths_json) if isinstance(paths_json, str) else paths_json\n",
        "    rows = []\n",
        "    for item in data.get(\"matched_paths\", []):\n",
        "        products, materials, routes, risks = [], [], [], []\n",
        "        for node in item.get(\"path_nodes\", []):\n",
        "            node_type = node.get(\"Type\") or node.get(\"type\")\n",
        "            name = node.get(\"name\") or node.get(\"entity_id\")\n",
        "            if node_type == \"Product\":\n",
        "                products.append(name)\n",
        "            elif node_type == \"Material\":\n",
        "                materials.append(name)\n",
        "            elif node_type == \"Route\":\n",
        "                routes.append(name)\n",
        "            elif node_type in {\"ChokePoint\", \"GeopoliticalRisk\", \"SeaRegion\", \"Risk\"}:\n",
        "                risks.append(name)\n",
        "        rows.append({\n",
        "            \"path\": item.get(\"path\", []),\n",
        "            \"products\": products,\n",
        "            \"materials\": materials,\n",
        "            \"routes\": routes,\n",
        "            \"risk_nodes\": risks,\n",
        "            \"matched_node\": item.get(\"matched_node\"),\n",
        "            \"depth\": item.get(\"depth\"),\n",
        "        })\n",
        "    return json.dumps({\"mappings\": rows}, ensure_ascii=False, indent=2)\n",
        "\n",
        "@tool(\"risk_score_paths\")\n",
        "def risk_score_paths(paths_json: str) -> str:\n",
        "    \"\"\"Compute simple exposure scores from Neo4j path depth and matched node type.\"\"\"\n",
        "    data = json.loads(paths_json) if isinstance(paths_json, str) else paths_json\n",
        "    scored = []\n",
        "    for item in data.get(\"matched_paths\", []):\n",
        "        depth = item.get(\"depth\", 1) or 1\n",
        "        matched = item.get(\"matched_node\")\n",
        "        matched_data = item.get(\"matched_node_data\", {})\n",
        "        node_type = matched_data.get(\"Type\") or matched_data.get(\"type\")\n",
        "        proximity = 1 / max(depth, 1)\n",
        "        risk_bonus = 0.25 if node_type in {\"ChokePoint\", \"GeopoliticalRisk\", \"Risk\"} else 0.0\n",
        "        score = round(min(1.0, 0.70 * proximity + risk_bonus), 3)\n",
        "        scored.append({\n",
        "            \"matched_node\": matched,\n",
        "            \"node_type\": node_type,\n",
        "            \"depth\": depth,\n",
        "            \"risk_score\": score,\n",
        "            \"risk_level\": \"high\" if score >= 0.65 else \"medium\" if score >= 0.35 else \"low\",\n",
        "            \"path\": item.get(\"path\", []),\n",
        "        })\n",
        "    return json.dumps({\"risk_assessment\": scored}, ensure_ascii=False, indent=2)\n",
        "\n",
        "@tool(\"visualize_supply_network_html\")\n",
        "def visualize_supply_network_html(paths_json: str, output_html: str = \"supply_chain_disruption_network.html\") -> str:\n",
        "    \"\"\"Create an HTML network visualization for disrupted Neo4j supply-chain paths.\"\"\"\n",
        "    data = json.loads(paths_json) if isinstance(paths_json, str) else paths_json\n",
        "    try:\n",
        "        from pyvis.network import Network\n",
        "        net = Network(height=\"750px\", width=\"100%\", directed=True, notebook=True)\n",
        "        added_nodes = set()\n",
        "        added_edges = set()\n",
        "        color_map = {\n",
        "            \"Company\": \"#1f77b4\", \"Supplier\": \"#2ca02c\", \"Product\": \"#9467bd\",\n",
        "            \"Material\": \"#8c564b\", \"Country\": \"#ff7f0e\", \"Region\": \"#bcbd22\",\n",
        "            \"Route\": \"#17becf\", \"ChokePoint\": \"#d62728\", \"GeopoliticalRisk\": \"#e377c2\",\n",
        "        }\n",
        "        for item in data.get(\"matched_paths\", []):\n",
        "            for node in item.get(\"path_nodes\", []):\n",
        "                node_id = node.get(\"entity_id\") or node.get(\"element_id\")\n",
        "                label = node.get(\"name\") or node_id\n",
        "                node_type = node.get(\"Type\") or node.get(\"type\")\n",
        "                if node_id not in added_nodes:\n",
        "                    net.add_node(node_id, label=label, title=json.dumps(node, ensure_ascii=False), color=color_map.get(node_type, \"#7f7f7f\"))\n",
        "                    added_nodes.add(node_id)\n",
        "            for idx, rel in enumerate(item.get(\"relations\", [])):\n",
        "                nodes = item.get(\"path_nodes\", [])\n",
        "                if idx + 1 >= len(nodes):\n",
        "                    continue\n",
        "                source = nodes[idx].get(\"entity_id\") or nodes[idx].get(\"element_id\")\n",
        "                target = nodes[idx + 1].get(\"entity_id\") or nodes[idx + 1].get(\"element_id\")\n",
        "                edge_key = (source, target, rel.get(\"relation\"))\n",
        "                if edge_key not in added_edges:\n",
        "                    net.add_edge(source, target, label=rel.get(\"relation\", \"\"))\n",
        "                    added_edges.add(edge_key)\n",
        "        net.write_html(output_html)\n",
        "        return str(Path(output_html).resolve())\n",
        "    except Exception as exc:\n",
        "        return f\"Visualization skipped: {exc}\"\n"
      ]
    },
