        "\n",
        "article_text = \"\"\"\n",
        "Tensions around the Taiwan Strait have increased, raising concerns about semiconductor\n",
        "shipping delays and disruption to electronics components used by automotive suppliers.\n",
        "\"\"\"\n",
        "focal_company = \"Hyundai\"\n",
        "\n",
        "# Agent 1의 최신 출력 파일입니다. disruption_monitoring_results.json을 우선 사용합니다.\n",
        "# 파일이 아직 없으면 기존 crewai_results 계열 파일로 fallback합니다.\n",
        "AGENT_DIR = Path(r\"C:\\Users\\dongwon\\OneDrive - seoultech.ac.kr\\바탕 화면\\대학 4_1\\캡스톤 디자인\\agent\")\n",
        "CREWAI_RESULTS_CANDIDATES = [\n",
        "    AGENT_DIR / \"disruption_monitoring_results.json\",\n",
        "    AGENT_DIR / \"agent1_out\" / \"disruption_monitoring_results.json\",\n",
        "    AGENT_DIR / \"agent1_out\" / \"crewai_results-2.json\",\n",
        "    AGENT_DIR / \"crewai_results.json\",\n",
        "]\n",
        "CREWAI_RESULTS_PATH = next((path for path in CREWAI_RESULTS_CANDIDATES if path.exists()), CREWAI_RESULTS_CANDIDATES[0])\n",
        "print(f\"Agent 1 results path: {CREWAI_RESULTS_PATH}\")\n",
        "\n",
        "def load_crewai_results(path: Path = CREWAI_RESULTS_PATH) -> Dict[str, Any]:\n",
        "    if not path.exists():\n",
        "        raise FileNotFoundError(\n",
        "            f\"Agent 1 result file not found: {path}. \"\n",
        "            \"Place disruption_monitoring_results.json in AGENT_DIR or update CREWAI_RESULTS_PATH.\"\n",
        "        )\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        return json.load(f)\n",
        "\n",
        "def agent1_result_rows(payload: Any) -> List[Dict[str, Any]]:\n",
        "    \"\"\"Support common Agent 1 output shapes.\"\"\"\n",
        "    if isinstance(payload, list):\n",
        "        return payload\n",
        "    if not isinstance(payload, dict):\n",
        "        return []\n",
        "    for key in [\"results\", \"disruptions\", \"articles\", \"items\", \"data\"]:\n",
        "        value = payload.get(key)\n",
        "        if isinstance(value, list):\n",
        "            return value\n",
        "    return [payload]\n",
        "\n",
        "def as_list(value: Any) -> List[Any]:\n",
        "    \"\"\"Normalize Agent 1 scalar/list fields into a clean list.\"\"\"\n",
        "    if value is None:\n",
        "        return []\n",
        "    if isinstance(value, list):\n",
        "        values = value\n",
        "    else:\n",
        "        values = [value]\n",
        "    return [item for item in values if item is not None and str(item).strip()]\n",
        "\n",
        "def unique_clean(values: List[Any]) -> List[str]:\n",
        "    \"\"\"Deduplicate while preserving order.\"\"\"\n",
        "    seen = set()\n",
        "    cleaned = []\n",
        "    for value in values:\n",
        "        text = str(value).strip()\n",
        "        if text and text.lower() not in seen:\n",
        "            cleaned.append(text)\n",
        "            seen.add(text.lower())\n",
        "    return cleaned\n",
        "\n",
        "def infer_companies_from_text(row: Dict[str, Any]) -> List[str]:\n",
        "    title_summary = \" \".join(str(row.get(k, \"\")) for k in [\"title\", \"summary\", \"reason\", \"event\"])\n",
        "    companies = []\n",
        "    for candidate in [\"Hyundai Motor\", \"Hyundai\", \"Kia\", \"Samsung\", \"LG\", \"SK hynix\", \"Toyota\"]:\n",
        "        if candidate.lower() in title_summary.lower():\n",
        "            companies.append(candidate)\n",
        "    return companies\n",
        "\n",
        "def disruption_from_agent1_result(row: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    \"\"\"Convert the current Agent 1 output row into Knowledge Graph Query Agent input.\"\"\"\n",
        "    disruption_type = (\n",
        "        row.get(\"disruption_type\")\n",
        "        or row.get(\"risk_category\")\n",
        "        or row.get(\"disruption_category\")\n",
        "        or row.get(\"type\")\n",
        "        or \"Other\"\n",
        "    )\n",
        "    event_type = row.get(\"event\") or row.get(\"event_type\") or row.get(\"disruption_event\") or disruption_type\n",
        "\n",
        "    countries = as_list(row.get(\"countries_involved\") or row.get(\"affected_countries\") or row.get(\"affected_country\") or row.get(\"countries\"))\n",
        "    regions = as_list(row.get(\"regions_involved\") or row.get(\"affected_regions\") or row.get(\"affected_location\") or row.get(\"regions\"))\n",
        "    companies = as_list(row.get(\"companies_involved\") or row.get(\"affected_companies\") or row.get(\"companies\")) + infer_companies_from_text(row)\n",
        "    industries = as_list(row.get(\"industries_involved\") or row.get(\"affected_industries\") or row.get(\"industries\"))\n",
        "    materials = as_list(row.get(\"materials_involved\") or row.get(\"affected_materials\") or row.get(\"materials\"))\n",
        "    components = as_list(row.get(\"components_involved\") or row.get(\"affected_components\") or row.get(\"components\"))\n",
        "    ports = as_list(row.get(\"ports_involved\") or row.get(\"affected_ports\") or row.get(\"ports\"))\n",
        "    chokepoints = as_list(row.get(\"chokepoints_involved\") or row.get(\"affected_chokepoints\") or row.get(\"chokepoints\"))\n",
        "    relevance = row.get(\"hyundai_relevance\") or row.get(\"relevance\")\n",
        "    risk_questions = as_list(row.get(\"risk_exposure_questions\") or row.get(\"kg_questions\") or row.get(\"diagnostic_questions\"))\n",
        "\n",
        "    if not risk_questions:\n",
        "        location_text = \", \".join(unique_clean(regions + countries)) or \"the affected area\"\n",
        "        risk_questions = [\n",
        "            (\n",
        "                f\"Which suppliers, products, materials, routes, chokepoints, or risk nodes connected to \"\n",
        "                f\"{focal_company} are exposed to {event_type} in {location_text}?\"\n",
        "            )\n",
        "        ]\n",
        "\n",
        "    risks = unique_clean([disruption_type, event_type, relevance] + risk_questions)\n",
        "\n",
        "    return {\n",
        "        \"type\": str(disruption_type),\n",
        "        \"event_type\": str(event_type),\n",
        "        \"summary\": row.get(\"summary\") or row.get(\"reason\") or \"\",\n",
        "        \"severity_score\": row.get(\"severity_score\"),\n",
        "        \"involved\": {\n",
        "            \"countries\": unique_clean(countries),\n",
        "            \"regions\": unique_clean(regions),\n",
        "            \"companies\": unique_clean(companies),\n",
        "            \"industries\": unique_clean(industries),\n",
        "            \"materials\": unique_clean(materials),\n",
        "            \"components\": unique_clean(components),\n",
        "            \"ports\": unique_clean(ports),\n",
        "            \"chokepoints\": unique_clean(chokepoints),\n",
        "            \"risks\": risks,\n",
        "        },\n",
        "        \"kg_questions\": unique_clean(risk_questions),\n",
        "        \"source\": {\n",
        "            \"title\": row.get(\"title\"),\n",
        "            \"url\": row.get(\"url\"),\n",
        "            \"reason\": row.get(\"reason\") or row.get(\"reasoning_brief\"),\n",
        "            \"confidence\": row.get(\"confidence\"),\n",
        "            \"hyundai_relevance\": row.get(\"hyundai_relevance\"),\n",
        "        },\n",
        "    }\n",
        "\n",
        "def iter_agent1_rows(path: Path = CREWAI_RESULTS_PATH, only_supply_chain: bool = True):\n",
        "    \"\"\"Yield original Agent 1 rows after skipping non-actionable/unknown-risk articles.\"\"\"\n",
        "    payload = load_crewai_results(path)\n",
        "    skipped = 0\n",
        "    for row in agent1_result_rows(payload):\n",
        "        if only_supply_chain and not is_actionable_disruption(row):\n",
        "            skipped += 1\n",
        "            continue\n",
        "        yield row\n",
        "    print(f\"Skipped {skipped} non-actionable or unknown-risk articles.\")\n",
        "\n",
        "def iter_agent1_disruptions(path: Path = CREWAI_RESULTS_PATH, only_supply_chain: bool = True):\n",
        "    for row in iter_agent1_rows(path, only_supply_chain=only_supply_chain):\n",
        "        yield disruption_from_agent1_result(row)\n",
        "\n",
        "def select_agent1_example_rows(path: Path = CREWAI_RESULTS_PATH, limit: int = 2) -> List[Dict[str, Any]]:\n",
        "    \"\"\"Keep original Agent 1 outputs so we can show the exact input before conversion.\"\"\"\n",
        "    rows = list(iter_agent1_rows(path, only_supply_chain=True))\n",
        "    return rows[:limit]\n",
        "\n",
        "def run_product_search_agent_deterministic(kg_result: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    \"\"\"Agent 3 deterministic version: map KG paths to products/materials/routes/risk nodes.\"\"\"\n",
        "    return json.loads(product_mapping_from_paths.run(json.dumps(kg_result, ensure_ascii=False)))\n",
        "\n",
        "def validate_agent2_agent3_result(result: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    kg_paths = result.get(\"kg_result\", {}).get(\"matched_paths\", [])\n",
        "    product_mappings = result.get(\"product_result\", {}).get(\"mappings\", [])\n",
        "    return {\n",
        "        \"neo4j_connected\": driver is not None,\n",
        "        \"agent2_matched_path_count\": len(kg_paths),\n",
        "        \"agent3_mapping_count\": len(product_mappings),\n",
        "        \"agent3_input_output_count_match\": len(kg_paths) == len(product_mappings),\n",
        "        \"sample_agent2_path\": kg_paths[0] if kg_paths else None,\n",
        "        \"sample_agent3_mapping\": product_mappings[0] if product_mappings else None,\n",
        "    }\n",
        "\n",
        "def run_deterministic_pipeline(disruption: Dict[str, Any], focal_company: str = \"Hyundai\"):\n",
        "    kg_result = neo4j_related_supply_chain(\n",
        "        focal_company=focal_company,\n",
        "        disruption=disruption,\n",
        "        max_depth=4,\n",
        "        use_llm_plan=True,\n",
        "    )\n",
        "    product_result = run_product_search_agent_deterministic(kg_result)\n",
        "    agent5_input = build_agent5_input_from_agent2(kg_result, product_result)\n",
        "    risk_result = json.loads(risk_score_paths.run(json.dumps(kg_result, ensure_ascii=False)))\n",
        "    # Agent 4 visualization is defined in a later cell and can be run after this validation step.\n",
        "    return {\n",
        "        \"kg_result\": kg_result,\n",
        "        \"product_result\": product_result,\n",
        "        \"agent5_input\": agent5_input,\n",
        "        \"risk_result\": risk_result,\n",
        "        \"visualization_html\": None,\n",
        "    }\n",
        "\n",
        "# 첫 번째 에이전트 결과 중 첫 번째 공급망 disruption을 두 번째 KG Query Agent 입력으로 사용\n",
        "agent1_example_rows = select_agent1_example_rows(CREWAI_RESULTS_PATH, limit=2)\n",
        "print(f\"Selected {len(agent1_example_rows)} Agent 1 example rows from {CREWAI_RESULTS_PATH.name}\")\n",
        "\n",
        "first_agent1_row = agent1_example_rows[0]\n",
        "print(\"Original Agent 1 output row:\")\n",
        "print(json.dumps(first_agent1_row, ensure_ascii=False, indent=2)[:2000])\n",
        "\n",
        "first_agent1_disruption = disruption_from_agent1_result(first_agent1_row)\n",
        "print(\"\\nConverted Agent 2 input disruption JSON:\")\n",
        "print(json.dumps(first_agent1_disruption, ensure_ascii=False, indent=2)[:2000])\n",
        "\n",
        "pipeline_result = run_deterministic_pipeline(first_agent1_disruption, focal_company)\n",
        "validation_report = validate_agent2_agent3_result(pipeline_result)\n",
        "print(json.dumps(validation_report, ensure_ascii=False, indent=2, default=str))\n",
        "pipeline_result\n"
      ]
    },
