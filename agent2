      "source": [
        "\n",
        "AGENT4_VISUALIZER_PROMPT = \"\"\"\n",
        "You are Supply Chain Network Visualization Agent.\n",
        "\n",
        "Goal:\n",
        "Integrate supply-chain paths and product information without loss, generate a\n",
        "human-interpretable hierarchical supply-chain network specification, render an\n",
        "interactive HTML file, and validate that every input path can be reconstructed.\n",
        "\n",
        "Do not invent companies, products, paths, or risk scores. Unknown products must be\n",
        "kept as unknown edges, not removed.\n",
        "\"\"\"\n",
        "\n",
        "TIER_STYLE = {\n",
        "    0: {\"color\": \"#0b3d91\", \"label\": \"Focal company\"},\n",
        "    1: {\"color\": \"#1f77b4\", \"label\": \"Tier 1\"},\n",
        "    2: {\"color\": \"#2ca02c\", \"label\": \"Tier 2\"},\n",
        "    3: {\"color\": \"#ff7f0e\", \"label\": \"Tier 3\"},\n",
        "    4: {\"color\": \"#9467bd\", \"label\": \"Tier 4\"},\n",
        "}\n",
        "RISK_STYLE = {\n",
        "    \"HIGH\": {\"color\": \"#d62728\", \"border\": \"#8b0000\"},\n",
        "    \"MEDIUM\": {\"color\": \"#ff7f0e\", \"border\": \"#b65c00\"},\n",
        "    \"LOW\": {\"color\": \"#2ca02c\", \"border\": \"#1b6e1b\"},\n",
        "}\n",
        "EVIDENCE_STYLE = {\n",
        "    \"confirmed\": {\"line_type\": \"solid\", \"color\": \"#555555\"},\n",
        "    \"inferred\": {\"line_type\": \"dashes\", \"color\": \"#777777\"},\n",
        "    \"unknown\": {\"line_type\": \"dashes\", \"color\": \"#aaaaaa\"},\n",
        "}\n",
        "\n",
        "def agent4_unique(values: List[Any]) -> List[str]:\n",
        "    seen, out = set(), []\n",
        "    for value in values:\n",
        "        if value is None:\n",
        "            continue\n",
        "        text = str(value).strip()\n",
        "        if text and text.lower() not in seen:\n",
        "            out.append(text)\n",
        "            seen.add(text.lower())\n",
        "    return out\n",
        "\n",
        "def agent4_node_id(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"company_id\") or node.get(\"entity_id\") or node.get(\"id\") or node.get(\"element_id\") or node.get(\"name\"))\n",
        "\n",
        "def agent4_node_label(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"company\") or node.get(\"name\") or node.get(\"label\") or node.get(\"entity_id\") or node.get(\"id\"))\n",
        "\n",
        "def agent4_node_type(node: Dict[str, Any]) -> str:\n",
        "    return str(node.get(\"Type\") or node.get(\"type\") or node.get(\"node_type\") or \"\")\n",
        "\n",
        "def agent4_is_company_node(node: Dict[str, Any]) -> bool:\n",
        "    node_type = agent4_node_type(node)\n",
        "    return node_type in {\"Company\", \"Supplier\"} or bool(node.get(\"company\") or node.get(\"company_id\"))\n",
        "\n",
        "def agent4_country(node: Dict[str, Any]) -> Optional[str]:\n",
        "    return node.get(\"country\") or node.get(\"Country\") or node.get(\"location\") or node.get(\"region\")\n",
        "\n",
        "def agent4_industry(node: Dict[str, Any]) -> Optional[str]:\n",
        "    return node.get(\"industry\") or node.get(\"Industry\") or node.get(\"sector\")\n",
        "\n",
        "def agent4_relation_name(rel: Dict[str, Any]) -> str:\n",
        "    props = rel.get(\"properties\", {}) if isinstance(rel, dict) else {}\n",
        "    return str(rel.get(\"relation\") or rel.get(\"type\") or props.get(\"type\") or props.get(\"relation\") or \"KG_RELATION\")\n",
        "\n",
        "def agent4_edge_products(rel: Dict[str, Any], mapping: Dict[str, Any]) -> List[str]:\n",
        "    props = rel.get(\"properties\", {}) if isinstance(rel, dict) else {}\n",
        "    candidates = []\n",
        "    for key in [\"product_supplied\", \"product\", \"products\", \"component\", \"material\"]:\n",
        "        value = props.get(key) or rel.get(key)\n",
        "        if isinstance(value, list):\n",
        "            candidates.extend(value)\n",
        "        elif value:\n",
        "            candidates.append(value)\n",
        "    candidates.extend(mapping.get(\"products\", []) or [])\n",
        "    candidates.extend(mapping.get(\"materials\", []) or [])\n",
        "    return agent4_unique(candidates) or [\"Unknown product\"]\n",
        "\n",
        "\n",
        "def lookup_products_produced_by_supplier(supplier_id: str, supplier_name: str, limit: int = 20) -> List[str]:\n",
        "    \"\"\"Ground edge product labels in Neo4j Supplier/Company -Produces-> Product facts.\"\"\"\n",
        "    if \"driver\" not in globals() or driver is None:\n",
        "        return []\n",
        "    query = \"\"\"\n",
        "    MATCH (s:Entity)-[r]->(p:Entity)\n",
        "    WHERE (\n",
        "        s.entity_id = $supplier_id\n",
        "        OR s.name = $supplier_name\n",
        "        OR ($supplier_name <> '' AND toLower(coalesce(s.name, '')) CONTAINS toLower($supplier_name))\n",
        "    )\n",
        "      AND coalesce(r.type, type(r)) = 'Produces'\n",
        "      AND coalesce(p.Type, p.type) = 'Product'\n",
        "    RETURN DISTINCT coalesce(p.name, p.entity_id) AS product\n",
        "    LIMIT $limit\n",
        "    \"\"\"\n",
        "    try:\n",
        "        with driver.session() as session:\n",
        "            return agent4_unique([\n",
        "                record[\"product\"]\n",
        "                for record in session.run(\n",
        "                    query,\n",
        "                    supplier_id=str(supplier_id or \"\"),\n",
        "                    supplier_name=str(supplier_name or \"\"),\n",
        "                    limit=limit,\n",
        "                )\n",
        "                if record[\"product\"]\n",
        "            ])\n",
        "    except Exception as exc:\n",
        "        print(f\"Agent 4 product lookup failed for supplier {supplier_name}: {exc}\")\n",
        "        return []\n",
        "\n",
        "def agent4_edge_products_with_supplier(\n",
        "    rel: Dict[str, Any],\n",
        "    mapping: Dict[str, Any],\n",
        "    supplier_node: Dict[str, Any],\n",
        ") -> List[str]:\n",
        "    \"\"\"Use edge/mapping products first, then Supplier -Produces-> Product from Neo4j.\"\"\"\n",
        "    products = [p for p in agent4_edge_products(rel, mapping) if p != \"Unknown product\"]\n",
        "    if products:\n",
        "        return agent4_unique(products)\n",
        "    return lookup_products_produced_by_supplier(\n",
        "        supplier_id=supplier_node.get(\"company_id\") or supplier_node.get(\"entity_id\") or supplier_node.get(\"id\"),\n",
        "        supplier_name=supplier_node.get(\"company\") or supplier_node.get(\"name\") or supplier_node.get(\"label\"),\n",
        "    ) or [\"Unknown product\"]\n",
        "\n",
        "def agent4_evidence_status(rel: Dict[str, Any]) -> str:\n",
        "    props = rel.get(\"properties\", {}) if isinstance(rel, dict) else {}\n",
        "    status = str(props.get(\"evidence_status\") or rel.get(\"evidence_status\") or \"\").strip().lower()\n",
        "    if status in EVIDENCE_STYLE:\n",
        "        return status\n",
        "    evidence = props.get(\"evidence\") or rel.get(\"evidence\")\n",
        "    confidence = props.get(\"confidence\") or rel.get(\"confidence\")\n",
        "    if evidence and str(evidence).strip():\n",
        "        return \"confirmed\"\n",
        "    if confidence not in [None, \"\"]:\n",
        "        try:\n",
        "            return \"confirmed\" if float(confidence) >= 0.75 else \"inferred\"\n",
        "        except Exception:\n",
        "            return \"inferred\"\n",
        "    return \"unknown\"\n",
        "\n",
        "def agent4_confidence(rel: Dict[str, Any]) -> Optional[float]:\n",
        "    props = rel.get(\"properties\", {}) if isinstance(rel, dict) else {}\n",
        "    value = props.get(\"confidence\") or rel.get(\"confidence\")\n",
        "    if value in [None, \"\"]:\n",
        "        return None\n",
        "    try:\n",
        "        return float(value)\n",
        "    except Exception:\n",
        "        return None\n",
        "\n",
        "def agent4_risk_lookup(risk_result: Optional[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:\n",
        "    lookup = {}\n",
        "    if not risk_result:\n",
        "        return lookup\n",
        "    for item in risk_result.get(\"risk_assessment\", []):\n",
        "        for key in [item.get(\"matched_node\"), item.get(\"supplier_name\"), item.get(\"supplier_id\")]:\n",
        "            if key:\n",
        "                score = item.get(\"risk_score\")\n",
        "                level = item.get(\"risk_level\")\n",
        "                lookup[str(key)] = {\n",
        "                    \"risk_score\": float(score) if score not in [None, \"\"] else None,\n",
        "                    \"risk_level\": str(level).upper() if level else None,\n",
        "                }\n",
        "    for item in risk_result.get(\"tier1_supplier_risk_scores\", []):\n",
        "        for key in [item.get(\"supplier_name\"), item.get(\"supplier_id\")]:\n",
        "            if key:\n",
        "                score = item.get(\"risk_score\")\n",
        "                level = item.get(\"risk_level\")\n",
        "                lookup[str(key)] = {\n",
        "                    \"risk_score\": float(score) if score not in [None, \"\"] else None,\n",
        "                    \"risk_level\": str(level).upper() if level else None,\n",
        "                }\n",
        "    return lookup\n",
        "\n",
        "def normalize_agent4_input(\n",
        "    kg_result: Dict[str, Any],\n",
        "    product_result: Optional[Dict[str, Any]] = None,\n",
        "    risk_result: Optional[Dict[str, Any]] = None,\n",
        ") -> Dict[str, Any]:\n",
        "    \"\"\"Convert Agent 2/3/5 outputs into the explicit Agent 4 input contract.\"\"\"\n",
        "    product_result = product_result or {}\n",
        "    mappings = product_result.get(\"mappings\", [])\n",
        "    focal_name = kg_result.get(\"focal_company\") or globals().get(\"focal_company\", \"Hyundai\")\n",
        "    focal_company = {\"company_id\": str(focal_name), \"company\": str(focal_name), \"tier\": 0}\n",
        "\n",
        "    paths = []\n",
        "    for path_idx, item in enumerate(kg_result.get(\"matched_paths\", []), start=1):\n",
        "        mapping = mappings[path_idx - 1] if path_idx - 1 < len(mappings) else {}\n",
        "        path_nodes = [node for node in item.get(\"path_nodes\", []) if agent4_is_company_node(node)]\n",
        "        if not path_nodes:\n",
        "            path_nodes = item.get(\"path_nodes\", [])\n",
        "\n",
        "        # Path direction in Neo4j may start at focal. Render supplier -> customer by reversing\n",
        "        # when the focal company is first.\n",
        "        names = [agent4_node_label(node) for node in path_nodes]\n",
        "        if names and str(focal_name).lower() in names[0].lower():\n",
        "            path_nodes = list(reversed(path_nodes))\n",
        "\n",
        "        normalized_nodes = []\n",
        "        for idx, node in enumerate(path_nodes):\n",
        "            tier_from_focal = len(path_nodes) - idx - 1\n",
        "            if str(focal_name).lower() in agent4_node_label(node).lower():\n",
        "                tier = 0\n",
        "            else:\n",
        "                tier = min(max(tier_from_focal, 1), SAFE_MAX_DEPTH if \"SAFE_MAX_DEPTH\" in globals() else 4)\n",
        "            normalized_nodes.append({\n",
        "                \"company_id\": agent4_node_id(node),\n",
        "                \"company\": agent4_node_label(node),\n",
        "                \"country\": agent4_country(node),\n",
        "                \"industry\": agent4_industry(node),\n",
        "                \"tier\": tier,\n",
        "                \"is_disrupted\": agent4_node_label(node) == str(item.get(\"matched_node\")),\n",
        "                \"source_node\": node,\n",
        "            })\n",
        "\n",
        "        links = []\n",
        "        rels = item.get(\"relations\", [])\n",
        "        rels_for_direction = list(reversed(rels)) if names and str(focal_name).lower() in names[0].lower() else rels\n",
        "        for rel_idx in range(max(0, len(normalized_nodes) - 1)):\n",
        "            rel = rels_for_direction[rel_idx] if rel_idx < len(rels_for_direction) else {}\n",
        "            links.append({\n",
        "                \"source\": normalized_nodes[rel_idx][\"company_id\"],\n",
        "                \"target\": normalized_nodes[rel_idx + 1][\"company_id\"],\n",
        "                \"relation\": agent4_relation_name(rel),\n",
        "                \"product_supplied\": agent4_edge_products_with_supplier(rel, mapping, normalized_nodes[rel_idx]),\n",
        "                \"evidence_status\": agent4_evidence_status(rel),\n",
        "                \"confidence\": agent4_confidence(rel),\n",
        "                \"source_relation\": rel,\n",
        "            })\n",
        "\n",
        "        paths.append({\n",
        "            \"path_id\": item.get(\"path_id\") or f\"path_{path_idx}\",\n",
        "            \"nodes\": normalized_nodes,\n",
        "            \"links\": links,\n",
        "            \"source_path\": item,\n",
        "            \"product_mapping\": mapping,\n",
        "        })\n",
        "\n",
        "    return {\n",
        "        \"focal_company\": focal_company,\n",
        "        \"paths\": paths,\n",
        "        \"risk_metrics\": agent4_risk_lookup(risk_result),\n",
        "        \"disruption\": kg_result.get(\"disruption\", {}),\n",
        "        \"query_plan\": kg_result.get(\"query_plan\", {}),\n",
        "        \"diagnostics\": kg_result.get(\"diagnostics\"),\n",
        "    }\n",
        "\n",
        "def build_agent4_graph_spec(agent4_input: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    node_table, edge_table = {}, {}\n",
        "    focal_id = str(agent4_input.get(\"focal_company\", {}).get(\"company_id\", \"\"))\n",
        "    risk_metrics = agent4_input.get(\"risk_metrics\") or {}\n",
        "\n",
        "    for path in agent4_input.get(\"paths\", []):\n",
        "        path_id = path.get(\"path_id\")\n",
        "        for node in path.get(\"nodes\", []):\n",
        "            node_id = str(node.get(\"company_id\"))\n",
        "            risk = risk_metrics.get(node_id) or risk_metrics.get(str(node.get(\"company\"))) or {}\n",
        "            existing = node_table.setdefault(node_id, {\n",
        "                \"id\": node_id,\n",
        "                \"label\": node.get(\"company\"),\n",
        "                \"tier\": node.get(\"tier\"),\n",
        "                \"country\": node.get(\"country\"),\n",
        "                \"industry\": node.get(\"industry\"),\n",
        "                \"is_disrupted\": False,\n",
        "                \"risk_score\": risk.get(\"risk_score\"),\n",
        "                \"risk_level\": risk.get(\"risk_level\"),\n",
        "                \"path_ids\": [],\n",
        "            })\n",
        "            existing[\"path_ids\"] = agent4_unique(existing[\"path_ids\"] + [path_id])\n",
        "            existing[\"is_disrupted\"] = bool(existing[\"is_disrupted\"] or node.get(\"is_disrupted\"))\n",
        "            existing[\"country\"] = existing[\"country\"] or node.get(\"country\")\n",
        "            existing[\"industry\"] = existing[\"industry\"] or node.get(\"industry\")\n",
        "            existing[\"tier\"] = min(existing[\"tier\"], node.get(\"tier\")) if existing[\"tier\"] is not None and node.get(\"tier\") is not None else node.get(\"tier\")\n",
        "            if risk.get(\"risk_score\") is not None:\n",
        "                existing[\"risk_score\"] = risk.get(\"risk_score\")\n",
        "            if risk.get(\"risk_level\"):\n",
        "                existing[\"risk_level\"] = risk.get(\"risk_level\")\n",
        "\n",
        "        for link in path.get(\"links\", []):\n",
        "            source, target = str(link.get(\"source\")), str(link.get(\"target\"))\n",
        "            products = agent4_unique(link.get(\"product_supplied\", []) or [\"Unknown product\"])\n",
        "            evidence_status = link.get(\"evidence_status\") or \"unknown\"\n",
        "            edge_id = f\"{source}->{target}\"\n",
        "            existing = edge_table.setdefault(edge_id, {\n",
        "                \"id\": edge_id,\n",
        "                \"source\": source,\n",
        "                \"target\": target,\n",
        "                \"products\": [],\n",
        "                \"evidence_status\": evidence_status,\n",
        "                \"confidence\": link.get(\"confidence\"),\n",
        "                \"path_ids\": [],\n",
        "            })\n",
        "            existing[\"products\"] = agent4_unique(existing[\"products\"] + products)\n",
        "            existing[\"path_ids\"] = agent4_unique(existing[\"path_ids\"] + [path_id])\n",
        "            if existing[\"evidence_status\"] == \"unknown\" and evidence_status != \"unknown\":\n",
        "                existing[\"evidence_status\"] = evidence_status\n",
        "            if existing[\"confidence\"] is None and link.get(\"confidence\") is not None:\n",
        "                existing[\"confidence\"] = link.get(\"confidence\")\n",
        "\n",
        "    nodes = []\n",
        "    for node in node_table.values():\n",
        "        tier = int(node.get(\"tier\") or 4)\n",
        "        risk_level = node.get(\"risk_level\")\n",
        "        risk_score = node.get(\"risk_score\")\n",
        "        if node[\"id\"] == focal_id or tier == 0:\n",
        "            color = TIER_STYLE[0][\"color\"]\n",
        "            size = 35\n",
        "        elif risk_level in RISK_STYLE:\n",
        "            color = RISK_STYLE[risk_level][\"color\"]\n",
        "            size = 20 + 30 * float(risk_score or 0)\n",
        "        else:\n",
        "            color = TIER_STYLE.get(tier, TIER_STYLE[4])[\"color\"]\n",
        "            size = 22\n",
        "        border_color = \"#d62728\" if node.get(\"is_disrupted\") else RISK_STYLE.get(risk_level, {}).get(\"border\", \"#555555\")\n",
        "        nodes.append({\n",
        "            **node,\n",
        "            \"style\": {\n",
        "                \"color\": color,\n",
        "                \"border_color\": border_color,\n",
        "                \"size\": round(size, 2),\n",
        "            },\n",
        "        })\n",
        "\n",
        "    edges = []\n",
        "    for edge in edge_table.values():\n",
        "        evidence = edge.get(\"evidence_status\") or \"unknown\"\n",
        "        style = EVIDENCE_STYLE.get(evidence, EVIDENCE_STYLE[\"unknown\"])\n",
        "        edges.append({\n",
        "            **edge,\n",
        "            \"style\": {\n",
        "                \"line_type\": style[\"line_type\"],\n",
        "                \"color\": style[\"color\"],\n",
        "            },\n",
        "        })\n",
        "\n",
        "    return {\n",
        "        \"directed\": True,\n",
        "        \"nodes\": sorted(nodes, key=lambda n: (n.get(\"tier\") if n.get(\"tier\") is not None else 99, n.get(\"label\") or \"\")),\n",
        "        \"edges\": sorted(edges, key=lambda e: e[\"id\"]),\n",
        "        \"legend\": {\n",
        "            \"tier\": TIER_STYLE,\n",
        "            \"risk_level\": RISK_STYLE,\n",
        "            \"evidence_status\": EVIDENCE_STYLE,\n",
        "        },\n",
        "    }\n",
        "\n",
        "def build_network_graph(graph_spec: Dict[str, Any]):\n",
        "    import networkx as nx\n",
        "    graph = nx.DiGraph()\n",
        "    for node in graph_spec.get(\"nodes\", []):\n",
        "        graph.add_node(node[\"id\"], **node)\n",
        "    for edge in graph_spec.get(\"edges\", []):\n",
        "        graph.add_edge(edge[\"source\"], edge[\"target\"], **edge)\n",
        "    return graph\n",
        "\n",
        "def validate_graph(graph, agent4_input: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    warnings, missing_edges, preserved = [], [], 0\n",
        "    for path in agent4_input.get(\"paths\", []):\n",
        "        path_ok = True\n",
        "        for link in path.get(\"links\", []):\n",
        "            source, target = str(link.get(\"source\")), str(link.get(\"target\"))\n",
        "            if not graph.has_edge(source, target):\n",
        "                path_ok = False\n",
        "                missing_edges.append({\n",
        "                    \"path_id\": path.get(\"path_id\"),\n",
        "                    \"source\": source,\n",
        "                    \"target\": target,\n",
        "                })\n",
        "        if path_ok:\n",
        "            preserved += 1\n",
        "    disconnected = [\n",
        "        node for node in graph.nodes\n",
        "        if graph.degree(node) == 0 and graph.nodes[node].get(\"tier\") != 0\n",
        "    ]\n",
        "    if disconnected:\n",
        "        warnings.append(\"There are disconnected non-focal nodes.\")\n",
        "    if missing_edges:\n",
        "        warnings.append(\"Some supplier-customer edges from input paths are missing.\")\n",
        "    return {\n",
        "        \"expected_path_count\": len(agent4_input.get(\"paths\", [])),\n",
        "        \"preserved_path_count\": preserved,\n",
        "        \"node_count\": graph.number_of_nodes(),\n",
        "        \"edge_count\": graph.number_of_edges(),\n",
        "        \"disconnected_nodes\": disconnected,\n",
        "        \"missing_edges\": missing_edges,\n",
        "        \"warnings\": warnings,\n",
        "    }\n",
        "\n",
        "def agent4_html_escape(value: Any) -> str:\n",
        "    import html\n",
        "    return html.escape(\"\" if value is None else str(value), quote=True)\n",
        "\n",
        "\n",
        "def agent4_source_url(disruption: Dict[str, Any]) -> Optional[str]:\n",
        "    source = disruption.get(\"source\", {}) if isinstance(disruption, dict) else {}\n",
        "    return (\n",
        "        source.get(\"url\")\n",
        "        or source.get(\"article_url\")\n",
        "        or disruption.get(\"article_url\")\n",
        "        or disruption.get(\"url\")\n",
        "    )\n",
        "\n",
        "def agent4_threat_explanation_fallback(disruption: Dict[str, Any]) -> str:\n",
        "    \"\"\"Create a short Korean explanation from grounded Agent 1 fields.\"\"\"\n",
        "    if not isinstance(disruption, dict):\n",
        "        return \"공급망 경로와 직접 연결되는 위협 여부를 그래프 경로 기준으로 확인해야 합니다.\"\n",
        "    involved = disruption.get(\"involved\", {}) or {}\n",
        "    disruption_type = disruption.get(\"type\") or \"공급망 리스크\"\n",
        "    summary = disruption.get(\"summary\") or disruption.get(\"source\", {}).get(\"reason\") or \"\"\n",
        "    regions = \", \".join(involved.get(\"regions\", []) or [])\n",
        "    countries = \", \".join(involved.get(\"countries\", []) or [])\n",
        "    materials = \", \".join(involved.get(\"materials\", []) or [])\n",
        "    chokepoints = \", \".join(involved.get(\"chokepoints\", []) or [])\n",
        "    industries = \", \".join(involved.get(\"industries\", []) or [])\n",
        "\n",
        "    focus = regions or countries or chokepoints or \"영향 지역\"\n",
        "    affected = materials or industries or \"물류 및 조달\"\n",
        "    if chokepoints:\n",
        "        return f\"{focus} 및 {chokepoints} 관련 {disruption_type}로 인해 {affected} 운송 지연과 비용 상승이 발생할 수 있어 현대차 공급망의 납기 리스크가 커질 수 있습니다.\"\n",
        "    if materials:\n",
        "        return f\"{focus}에서 발생한 {disruption_type}가 {materials} 조달 안정성을 낮춰 생산 원가와 공급 일정에 영향을 줄 수 있습니다.\"\n",
        "    if summary:\n",
        "        return f\"기사 내용상 {focus} 관련 {disruption_type}가 확인되며, 공급망 경로와 연결될 경우 부품 조달 지연이나 물류 비용 상승으로 이어질 수 있습니다.\"\n",
        "    return f\"{focus} 관련 {disruption_type}가 공급망 경로와 연결될 경우 납기, 원가, 대체 조달 측면의 위험이 발생할 수 있습니다.\"\n",
        "\n",
        "def generate_agent4_korean_threat_explanation(disruption: Dict[str, Any], graph_spec: Dict[str, Any]) -> str:\n",
        "    \"\"\"Use LLM only for concise Korean wording; fall back to grounded Agent 1 fields.\"\"\"\n",
        "    api_key = os.getenv(\"VISUALIZER_OPENAI_API_KEY\")\n",
        "    if not api_key:\n",
        "        return agent4_threat_explanation_fallback(disruption)\n",
        "    try:\n",
        "        from openai import OpenAI\n",
        "        client = OpenAI(api_key=api_key)\n",
        "        compact = {\n",
        "            \"disruption_type\": disruption.get(\"type\"),\n",
        "            \"event_type\": disruption.get(\"event_type\"),\n",
        "            \"summary\": disruption.get(\"summary\"),\n",
        "            \"involved\": disruption.get(\"involved\", {}),\n",
        "            \"source\": disruption.get(\"source\", {}),\n",
        "            \"node_count\": len(graph_spec.get(\"nodes\", [])),\n",
        "            \"edge_count\": len(graph_spec.get(\"edges\", [])),\n",
        "        }\n",
        "        response = client.chat.completions.create(\n",
        "            model=os.getenv(\"VISUALIZER_OPENAI_MODEL\", \"gpt-4o-mini\"),\n",
        "            temperature=0.0,\n",
        "            messages=[\n",
        "                {\n",
        "                    \"role\": \"system\",\n",
        "                    \"content\": (\n",
        "                        \"너는 공급망 리스크 시각화 설명 에이전트다. \"\n",
        "                        \"입력 JSON에 있는 사실만 사용하고, 기업/제품/경로/위험 점수를 새로 만들지 않는다. \"\n",
        "                        \"한국어 한 문장, 80자 이내로 위협 가능성을 설명한다.\"\n",
        "                    ),\n",
        "                },\n",
        "                {\n",
        "                    \"role\": \"user\",\n",
        "                    \"content\": json.dumps(compact, ensure_ascii=False),\n",
        "                },\n",
        "            ],\n",
        "        )\n",
        "        text = response.choices[0].message.content.strip()\n",
        "        return text or agent4_threat_explanation_fallback(disruption)\n",
        "    except Exception as exc:\n",
        "        print(f\"Agent 4 LLM explanation failed; using fallback: {exc}\")\n",
        "        return agent4_threat_explanation_fallback(disruption)\n",
        "\n",
        "def render_interactive_html(graph, options: Dict[str, Any]) -> Dict[str, Any]:\n",
        "    try:\n",
        "        from pyvis.network import Network\n",
        "    except ModuleNotFoundError:\n",
        "        return {\"format\": \"html\", \"file_path\": None, \"status\": \"failed\", \"error\": \"pyvis is not installed\"}\n",
        "\n",
        "    graph_spec = options[\"graph_spec\"]\n",
        "    agent4_input = options[\"agent4_input\"]\n",
        "    output_path = Path(options.get(\"output_html\", \"agent4_supply_chain_network.html\"))\n",
        "    disruption = agent4_input.get(\"disruption\", {})\n",
        "    source = disruption.get(\"source\", {}) if isinstance(disruption, dict) else {}\n",
        "    title = source.get(\"title\") or disruption.get(\"event_type\") or disruption.get(\"type\") or \"Supply chain disruption\"\n",
        "    article_url = agent4_source_url(disruption)\n",
        "    summary = disruption.get(\"summary\") or source.get(\"reason\") or \"\"\n",
        "    affected = disruption.get(\"involved\", {}) if isinstance(disruption, dict) else {}\n",
        "    korean_threat = generate_agent4_korean_threat_explanation(disruption, graph_spec)\n",
        "\n",
        "    net = Network(height=\"760px\", width=\"100%\", directed=True, notebook=True, cdn_resources=\"in_line\")\n",
        "    net.set_options(\"\"\"\n",
        "    {\n",
        "      \"layout\": {\n",
        "        \"hierarchical\": {\n",
        "          \"enabled\": true,\n",
        "          \"direction\": \"LR\",\n",
        "          \"sortMethod\": \"directed\",\n",
        "          \"levelSeparation\": 190,\n",
        "          \"nodeSpacing\": 150\n",
        "        }\n",
        "      },\n",
        "      \"physics\": {\"enabled\": false},\n",
        "      \"interaction\": {\"hover\": true, \"navigationButtons\": true, \"keyboard\": true},\n",
        "      \"edges\": {\"arrows\": {\"to\": {\"enabled\": true}}, \"smooth\": {\"type\": \"cubicBezier\", \"forceDirection\": \"horizontal\"}}\n",
        "    }\n",
        "    \"\"\")\n",
        "\n",
        "    for node in graph_spec.get(\"nodes\", []):\n",
        "        tooltip = {\n",
        "            \"company\": node.get(\"label\"),\n",
        "            \"country\": node.get(\"country\"),\n",
        "            \"industry\": node.get(\"industry\"),\n",
        "            \"tier\": node.get(\"tier\"),\n",
        "            \"disruption_status\": \"disrupted\" if node.get(\"is_disrupted\") else \"not marked disrupted\",\n",
        "            \"risk_score\": node.get(\"risk_score\"),\n",
        "            \"risk_level\": node.get(\"risk_level\"),\n",
        "            \"path_ids\": node.get(\"path_ids\", []),\n",
        "        }\n",
        "        net.add_node(\n",
        "            node[\"id\"],\n",
        "            label=node.get(\"label\"),\n",
        "            level=int(node.get(\"tier\") or 0),\n",
        "            title=json.dumps(tooltip, ensure_ascii=False, indent=2),\n",
        "            color={\n",
        "                \"background\": node[\"style\"][\"color\"],\n",
        "                \"border\": node[\"style\"][\"border_color\"],\n",
        "            },\n",
        "            size=node[\"style\"][\"size\"],\n",
        "            borderWidth=4 if node.get(\"is_disrupted\") or node.get(\"risk_level\") == \"HIGH\" else 2,\n",
        "        )\n",
        "\n",
        "    for edge in graph_spec.get(\"edges\", []):\n",
        "        products = edge.get(\"products\") or [\"Unknown product\"]\n",
        "        tooltip = {\n",
        "            \"supplied_product\": products,\n",
        "            \"evidence_status\": edge.get(\"evidence_status\"),\n",
        "            \"confidence\": edge.get(\"confidence\"),\n",
        "            \"path_ids\": edge.get(\"path_ids\", []),\n",
        "        }\n",
        "        net.add_edge(\n",
        "            edge[\"source\"],\n",
        "            edge[\"target\"],\n",
        "            label=\", \".join(products[:2]) + (\" ...\" if len(products) > 2 else \"\"),\n",
        "            title=json.dumps(tooltip, ensure_ascii=False, indent=2),\n",
        "            color=edge[\"style\"][\"color\"],\n",
        "            dashes=edge[\"style\"][\"line_type\"] == \"dashes\",\n",
        "        )\n",
        "\n",
        "    net.write_html(str(output_path))\n",
        "    html_text = output_path.read_text(encoding=\"utf-8\")\n",
        "    meta = f\"\"\"\n",
        "<section style=\"font-family:Arial,sans-serif;margin:16px 18px 8px 18px;\">\n",
        "  <h2 style=\"margin:0 0 8px 0;\">Supply Chain Network Visualization</h2>\n",
        "  <div style=\"margin-bottom:6px;\"><strong>Article:</strong> {agent4_html_escape(title)}</div>\n",
        "  <div style=\"margin-bottom:6px;\"><strong>URL:</strong> {f'<a href=\"{agent4_html_escape(article_url)}\" target=\"_blank\" rel=\"noopener noreferrer\">{agent4_html_escape(article_url)}</a>' if article_url else 'N/A'}</div>\n",
        "  <div style=\"margin-bottom:6px;\"><strong>Disruption:</strong> {agent4_html_escape(disruption.get('type'))} / {agent4_html_escape(disruption.get('event_type'))}</div>\n",
        "  <div style=\"margin-bottom:6px;\"><strong>예상 위협:</strong> {agent4_html_escape(korean_threat)}</div>\n",
