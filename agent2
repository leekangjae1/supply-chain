        "\n",
        "def get_focal_company_candidates(limit: int = 20) -> List[str]:\n",
        "    \"\"\"Read candidate companies/suppliers from Neo4j for examples.\"\"\"\n",
        "    query = \"\"\"\n",
        "    MATCH (e:Entity)\n",
        "    WHERE e.Type IN ['Company', 'Supplier']\n",
        "      AND e.name IS NOT NULL\n",
        "    RETURN e.name AS name, e.Type AS type\n",
        "    ORDER BY CASE e.Type WHEN 'Company' THEN 0 ELSE 1 END, e.name\n",
        "    LIMIT $limit\n",
        "    \"\"\"\n",
        "    with driver.session() as session:\n",
        "        return [record[\"name\"] for record in session.run(query, limit=limit)]\n",
        "\n",
        "def choose_focal_company_for_example(disruption: Dict[str, Any], fallback_index: int = 0) -> str:\n",
        "    \"\"\"Prefer a company mentioned by Agent 1; otherwise use the KG candidate list.\"\"\"\n",
        "    for company in disruption.get(\"involved\", {}).get(\"companies\", []):\n",
        "        if company:\n",
        "            return company\n",
        "    candidates = get_focal_company_candidates(limit=20)\n",
        "    if candidates:\n",
        "        return candidates[fallback_index % len(candidates)]\n",
        "    return focal_company\n",
        "\n",
        "def run_agent2_agent4_example(agent1_row: Dict[str, Any], focal_company: Optional[str] = None, example_id: int = 1) -> Dict[str, Any]:\n",
        "    \"\"\"Show Agent 1 input conversion, Agent 2 query, and Agent 4 visualization.\"\"\"\n",
        "    disruption = disruption_from_agent1_result(agent1_row)\n",
        "    selected_focal_company = focal_company or choose_focal_company_for_example(disruption, fallback_index=example_id - 1)\n",
        "\n",
        "    print(\"=\" * 100)\n",
        "    print(f\"TEST EXAMPLE {example_id}\")\n",
        "\n",
        "    print(\"\\n1. Agent 1 output used as input\")\n",
        "    print(json.dumps(agent1_row, ensure_ascii=False, indent=2))\n",
        "\n",
        "    print(\"\\n2. Agent 2 normalized input from Agent 1 output\")\n",
        "    print(json.dumps(disruption, ensure_ascii=False, indent=2))\n",
        "    print(f\"\\nSelected focal company for this example: {selected_focal_company}\")\n",
        "\n",
        "    kg_result = neo4j_related_supply_chain(\n",
        "        focal_company=selected_focal_company,\n",
        "        disruption=disruption,\n",
        "        max_depth=4,\n",
        "        limit=100,\n",
        "        use_llm_plan=True,\n",
        "    )\n",
        "\n",
        "    product_result = run_product_search_agent_deterministic(kg_result)\n",
        "    agent5_input = build_agent5_input_from_agent2(kg_result, product_result)\n",
        "    risk_result = json.loads(risk_score_paths.run(json.dumps(kg_result, ensure_ascii=False)))\n",
        "\n",
        "    print(\"\\n3. Agent 2 LLM output: query plan\")\n",
        "    print(json.dumps(kg_result.get(\"query_plan\", {}), ensure_ascii=False, indent=2))\n",
        "\n",
        "    print(\"\\n4. Neo4j Cypher query generated from LLM query plan\")\n",
        "    print(kg_result.get(\"cypher\"))\n",
        "\n",
        "    print(\"\\nCypher params\")\n",
        "    print(json.dumps(kg_result.get(\"cypher_params\", {}), ensure_ascii=False, indent=2, default=str))\n",
        "\n",
        "    matched_paths = kg_result.get(\"matched_paths\", [])\n",
        "    print(f\"\\nCypher matched path count: {len(matched_paths)}\")\n",
        "    if matched_paths:\n",
        "        compact_paths = [\n",
        "            {\n",
        "                \"depth\": item.get(\"depth\"),\n",
        "                \"matched_node\": item.get(\"matched_node\"),\n",
        "                \"path\": item.get(\"path\"),\n",
        "                \"relations\": [rel.get(\"relation\") for rel in item.get(\"relations\", [])],\n",
        "            }\n",
        "            for item in matched_paths[:5]\n",
        "        ]\n",
        "        print(\"\\nFirst matched paths\")\n",
        "        print(json.dumps(compact_paths, ensure_ascii=False, indent=2, default=str))\n",
        "    else:\n",
        "        print(\"No path returned. Check whether the CSV was loaded, focal company name matches, or query plan terms exist in KG.\")\n",
        "\n",
        "    output_html = f\"agent4_knowledge_graph_example_{example_id}.html\"\n",
        "    agent4_result = visualize_agent4_knowledge_graph(\n",
        "        kg_result=kg_result,\n",
        "        product_result=product_result,\n",
        "        risk_result=risk_result,\n",
        "        output_html=output_html,\n",
        "    )\n",
        "    html_path = agent4_result.get(\"render_result\", {}).get(\"file_path\")\n",
        "    print(f\"\\n5. Agent 4 knowledge graph visualization: {html_path if html_path else 'not created'}\")\n",
        "    print(\"Agent 4 validation:\")\n",
        "    print(json.dumps(agent4_result.get(\"validation\", {}), ensure_ascii=False, indent=2))\n",
        "\n",
        "    return {\n",
        "        \"input\": disruption,\n",
        "        \"kg_result\": kg_result,\n",
        "        \"product_result\": product_result,\n",
        "        \"agent5_input\": agent5_input,\n",
        "        \"risk_result\": risk_result,\n",
        "        \"agent4_result\": agent4_result,\n",
        "        \"visualization_html\": html_path,\n",
