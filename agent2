        "        \"countries\": \", \".join(item[\"input\"].get(\"involved\", {}).get(\"countries\", [])),\n",
        "        \"industries\": \", \".join(item[\"input\"].get(\"involved\", {}).get(\"industries\", [])),\n",
        "        \"matched_paths\": len(item[\"kg_result\"].get(\"matched_paths\", [])),\n",
        "        \"agent5_affected_paths\": len(item[\"agent5_input\"].get(\"affected_paths\", [])),\n",
        "        \"agent4_status\": item[\"agent4_result\"].get(\"render_result\", {}).get(\"status\"),\n",
        "        \"preserved_paths\": item[\"agent4_result\"].get(\"validation\", {}).get(\"preserved_path_count\"),\n",
        "        \"visualization_html\": item[\"visualization_html\"],\n",
        "    }\n",
        "    for idx, item in enumerate(agent2_agent4_examples, start=1)\n",
        "])\n"
